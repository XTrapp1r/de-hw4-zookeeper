# ===== Этап 2. Конфигурации: строки server.N одинаковые, clientPort / admin.serverPort / dataDir у каждого свои =====

$ cat zk/zk1/conf/zoo.cfg
tickTime=2000
initLimit=10
syncLimit=5
minSessionTimeout=4000
maxSessionTimeout=40000
4lw.commands.whitelist=srvr,stat,ruok,mntr,conf,cons,dump
server.1=127.0.0.1:2888:3888
server.2=127.0.0.1:2889:3889
server.3=127.0.0.1:2890:3890

dataDir=/Users/admin/Desktop/rustfs_hw/hw4/data/zk1
clientPort=2181
admin.serverPort=8081

$ diff zk/zk1/conf/zoo.cfg zk/zk2/conf/zoo.cfg; diff zk/zk1/conf/zoo.cfg zk/zk3/conf/zoo.cfg; true
